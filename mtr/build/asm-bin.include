include $(root)/build/common.include

build-asm-bins = $(call output-file,$(asm-bins),$(BIN-SUFFIX))
build-asm-bins-stems = $(call assemble-stems,$(asm-bins),$(BIN-SUFFIX))
asm-stems += $(build-asm-bins-stems)
build-asm-bins-objects = $(call output-file,$(build-asm-bins-stems),$(OBJ-SUFFIX))

asm-bins-lib-files = $(addprefix $(SHARED-LIB-DIR)/,$(addsuffix $(LIB-SUFFIX),$(asm-bin-libs)))

$(OUTPUT-DIR)/%$(BIN-SUFFIX):
	$(Z88DK-ASM) -L$(SHARED-LIB-DIR) -I$(SHARED-INCLUDE-DIR) -s -l -m -g -b \
	$(addprefix -l,$(asm-bins-lib-files)) \
	$(call output-file,$(call assemble-stems,$(basename $(notdir $@)),$(BIN-SUFFIX)),$(OBJ-SUFFIX)) \
	-o$@

build: $(build-asm-bins)

include $(root)/build/asm.include

$(build-asm-bins): $(build-asm-bins-objects) $(asm-bins-lib-files)
