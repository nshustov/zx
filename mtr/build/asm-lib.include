include $(root)/build/common.include

build-asm-libs = $(call output-file,$(asm-libs),$(LIB-SUFFIX))

asm-stems += $(call assemble-stems,$(asm-libs),$(LIB-SUFFIX))

$(OUTPUT-DIR)/%$(LIB-SUFFIX):
	$(Z88DK-ASM) -l -I$(SHARED-INCLUDE-DIR) $(call output-file,$(call assemble-stems,$(basename $(notdir $@)),$(LIB-SUFFIX)),$(OBJ-SUFFIX)) -x$@

ifneq (,$(shared-asm-libs))
publish-asm-libs = $(foreach lib,$(shared-asm-libs),$(SHARED-LIB-DIR)/$(lib)$(LIB-SUFFIX))

$(publish-asm-libs): $(build-asm-libs)
build: $(publish-asm-libs)

$(SHARED-LIB-DIR)/%$(LIB-SUFFIX): $(OUTPUT-DIR)/%$(LIB-SUFFIX)
	cp -f $< $@

endif

build: $(build-asm-libs)

include $(root)/build/asm.include

$(build-asm-libs) : $(build-asm-objects)


