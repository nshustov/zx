ifndef -ASM-INCLUDE-
-ASM-INCLUDE- := 1

include $(root)/build/common.include

#########################################
# .asm compilation rules
#########################################

build-asm-objects += $(call output-file,$(asm-stems),$(OBJ-SUFFIX))

ifneq (,$(asm.module))
build-asm-objects += $(call output-file,$(call module-contents,$(asm.module)),$(OBJ-SUFFIX))
endif

build: $(build-asm-objects)

$(OUTPUT-DIR)/%$(OBJ-SUFFIX) : %$(ASM-SUFFIX)
	$(Z88DK-ASM) -I$(SHARED-INCLUDE-DIR) -s -l -m -g "$<" -O$(OUTPUT-DIR)

#########################################
# .shared includes publishing
#########################################

ifneq ($(shared-includes),)

$(SHARED-INCLUDE-DIR)/%$(INC-SUFFIX) : %$(INC-SUFFIX)
	cp -f "$<" "$@"

build-shared-includes += $(addprefix $(SHARED-INCLUDE-DIR)/,$(shared-includes))

$(build-shared-includes) : | $(SHARED-INCLUDE-DIR)

ifneq ($(build-asm-stems),)
$(build-asm-stems) : $(build-shared-includes)
endif

build: $(build-shared-includes)

endif

endif
