ifndef -COMMON-INCLUDE-
-COMMON-INCLUDE- := 1

.SUFFIXES :

include $(root)/config/config.include

INC-SUFIX:=.inc
ASM-SUFFIX:=.asm
OBJ-SUFFIX:=.o
SYM-SUFFIX:=.sym
MAP-SUFFIX:=.map
TAP-SUFFIX:=.tap
DEF-SUFFIX:=.def
LST-SUFFIX:=.lis
LIB-SUFFIX:=.lib
BIN-SUFFIX:=.bin
MODULE-SUFFIX:=.module

FUSE-COMMAND = bash -c 'fuse --no-aspect-hint $(1) &!' || true

$(OUTPUT-DIR):
	mkdir -p "$@"

$(SHARED-LIB-DIR):
	mkdir -p "$@"

$(SHARED-INCLUDE-DIR):
	mkdir -p "$@"

.DEFAULT_GOAL := build

pre-build: | $(OUTPUT-DIR) $(SHARED-LIB-DIR) $(SHARED-INCLUDE-DIR)
build: pre-build
after-build: build
install: after-build

clean:
	rm -rf $(OUTPUT-DIR)

echo-var:
	@echo $(echo-var-prefix)$($(var))

ifneq ($(VERBOSE),)
export Z80ASM := -v
endif

include $(root)/build/utils.include

endif
